{
  "name": "nexus-mcu-tracker",
  "version": "1.0.0",
  "productName": "Nexus MCU",
  "description": "Mapa interactivo del multiverso audiovisual de Marvel.",
  "author": "Marco Marquez",
  "main": "desktop/main.cjs",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run typecheck && node --test tests/nexus-cloud.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app desktop supabase tests next.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:catalog": "node scripts/generate-catalog-migration.mjs",
    "desktop:build": "vite build --config desktop/vite.config.ts",
    "desktop:start": "npm run desktop:build && electron .",
    "desktop:package": "npm run desktop:build && electron-forge package",
    "desktop:make": "npm run desktop:build && electron-forge make"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "drizzle-orm": "0.45.2",
    "idb": "^8.0.3",
    "next": "^16.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "drizzle-kit": "0.31.10",
    "electron": "42.7.1",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
